# Supabase project credentials (server key must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required for trusted recovery-link redirects and first-run setup
APP_URL=http://localhost:3000
PORTAL_BOOTSTRAP_SECRET=

# Airtable — keep server-side only; exact field map and company scoping require verification
AIRTABLE_PERSONAL_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_FIELD_MAP_JSON=
AIRTABLE_COMPANY_RECORD_IDS_JSON=
AIRTABLE_SCHEMA_MAPPING_VERIFIED=false
AIRTABLE_TENANT_MAPPING_VERIFIED=false

# Make POD intake — samples confirm fields; keep gates false until multipart receipt and dedupe are verified
MAKE_POD_SUBMISSION_WEBHOOK_URL=
MAKE_POD_UPLOAD_MODE=
MAKE_POD_CONTRACT_VERIFIED=false
MAKE_POD_IDEMPOTENCY_VERIFIED=false
POD_MAX_UPLOAD_BYTES=4194304
